      "properties": {
        "entityId": "red-2-army",
        "startDate": "1936-04-25",
        "endDate": "1936-07-05",
        "order": 8,
        "segmentType": "advance",
        "name": {
          "zh": "石鼓—中甸—得荣—巴塘—白玉—甘孜（红二军团）",
          "en": "Shigu–Zhongdian–Derong–Batang–Baiyü–Garzê (Second Army Group)"
        },
        "description": {
          "zh": "红二军团由石鼓渡金沙江，翻越雅哈雪山进中甸，经得荣、巴安（今巴塘）、白玉北上甘孜；途中翻越月日茨普、藏巴拉、恶热拉、麦拉、生欧拉等垭口。6 月 18 日恶热拉、麦拉为两路并行，路线合为一条示意线。路线为示意，待按行军日志细化。",
          "en": "The Second Army Group crossed the Jinsha River at Shigu, crossed Yaha Snow Mountain to Zhongdian, and moved north via Derong, Batang, and Baiyü to Garzê, crossing the Yuericipu, Zangbala, Ere, Maila, and Sheng’oula passes. On 18 June the Ere and Maila crossings were made by two parallel columns; the route combines them into one schematic line. The route is schematic and awaits refinement from march logs."
        },
        "extensions": {
          "precision": "schematic"
        }
