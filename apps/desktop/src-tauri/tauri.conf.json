{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "史迹",
  "version": "1.0.14",
  "identifier": "com.openchronicle.atlas.desktop",
  "build": {
    "beforeDevCommand": "pnpm --filter @atlas/web dev --mode desktop",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm --filter @atlas/web build:desktop",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "史迹 · 时空地图",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Education",
    "shortDescription": "历史事件时空地图",
    "longDescription": "以地图与时间轴浏览历史专题的路线、事件与时空演变。内置 10 个专题数据包，可离线浏览。",
    "copyright": "© 2026 OpenChronicle Atlas",
    "macOS": {
      "minimumSystemVersion": "13.0",
      "bundleVersion": "10014",
      "entitlements": "entitlements.plist"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
