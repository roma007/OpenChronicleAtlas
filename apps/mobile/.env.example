# 复制为 .env.local 后填写，不要提交真实 Key
# Android
EXPO_PUBLIC_AMAP_ANDROID_KEY=

# iOS / iPadOS
EXPO_PUBLIC_AMAP_IOS_KEY=

# 可选：启用远端数据（默认使用打包进 App 的 data/atlases，离线可用）
# 以后建好服务器后填入，即可切换为「远端优先 + 内置回退」
# EXPO_PUBLIC_DATA_BASE_URL=https://<domain>/data/atlases

# 可选：线上站点地址与隐私政策地址（仅用于外部链接）
# EXPO_PUBLIC_SITE_URL=https://<domain>
# EXPO_PUBLIC_PRIVACY_URL=https://<domain>/privacy
