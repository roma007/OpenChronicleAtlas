{
  "name": "open-chronicle-atlas",
  "version": "1.0.21",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "dev": "pnpm --filter @atlas/web dev",
    "build": "pnpm build:search-index && pnpm --filter @atlas/web build",
    "desktop:dev": "pnpm --filter @atlas/desktop dev",
    "desktop:bundle:mac": "pnpm --filter @atlas/desktop bundle:mac",
    "desktop:bundle:win": "pnpm --filter @atlas/desktop bundle:win",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "eslint .",
    "validate:data": "tsx scripts/validate-data.ts",
    "check:versions": "tsx scripts/check-versions.ts",
    "version:bump": "tsx scripts/bump-version.ts",
    "prepare": "git config core.hooksPath .githooks || true",
    "build:search-index": "tsx scripts/build-search-index.ts",
    "build:mobile-data": "tsx scripts/build-mobile-data.ts",
    "release": "bash scripts/deploy.sh",
    "ops:inbox": "bash scripts/ops-inbox.sh",
    "check:routes": "tsx scripts/check-event-routes.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/node": "^22.10.1",
    "eslint": "^9.15.0",
    "prettier": "^3.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.15.0",
    "vitest": "^2.1.5"
  }
}
