{
  "name": "open-chronicle-atlas",
  "version": "0.62.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "dev": "pnpm --filter @atlas/web dev",
    "build": "pnpm build:search-index && pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "eslint .",
    "validate:data": "tsx scripts/validate-data.ts",
    "check:versions": "tsx scripts/check-versions.ts",
    "build:search-index": "tsx scripts/build-search-index.ts",
    "check:routes": "tsx scripts/check-event-routes.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/node": "^22.10.1",
    "eslint": "^9.15.0",
    "prettier": "^3.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.15.0",
    "vitest": "^2.1.5"
  }
}
